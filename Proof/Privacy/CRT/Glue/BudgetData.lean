    Nat.ble
      ((3 * (padSwapNum + 637 * (2 ^ 384 % p) * 2 ^ 3968) * (M * p * (r - 1))
        + (1284 * (p - 1) ^ 2 + 273 * p) * (2 ^ 4352 * p * (r - 1))
