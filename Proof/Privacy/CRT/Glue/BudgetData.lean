        + (364 + 455) * (2 ^ 4352 * M * p)
        + (185 + 1) * 2 ^ 4224 * (M * p * (r - 1))) * 2 ^ 100)
      (2 ^ 4352 * M * p * (r - 1)) = true := by decide +kernel

/-- The constant is `2^-104.731`, `0.03766` of the unit; the room is a factor `26.6`: it survives 16 times its value. -/
theorem chainConstant_room :
    Nat.ble
      ((3 * (padSwapNum + 637 * (2 ^ 384 % p) * 2 ^ 3968) * (M * p * (r - 1))
        + (1284 * (p - 1) ^ 2 + 273 * p) * (2 ^ 4352 * p * (r - 1))
